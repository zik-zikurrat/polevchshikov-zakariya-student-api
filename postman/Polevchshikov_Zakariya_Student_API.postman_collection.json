          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Zakariya\",\n  \"lastName\": \"Polevchshikov\",\n  \"email\": \"zakariya.polevchshikov@student.example\",\n  \"groupName\": \"IT2-2312\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
