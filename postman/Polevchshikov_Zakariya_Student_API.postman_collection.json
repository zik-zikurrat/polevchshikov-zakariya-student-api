              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const s = pm.response.json();",
              "pm.test('has id and my surname', () => { pm.expect(s.id).to.be.a('number'); pm.expect(s.lastName).to.eql('Polevchshikov'); });",
              "pm.collectionVariables.set('studentId', s.id);"
            ]
          }
        }
      ]
    },
