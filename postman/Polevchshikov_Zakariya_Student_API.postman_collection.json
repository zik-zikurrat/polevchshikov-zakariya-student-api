          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('shows student name', () => pm.expect(pm.response.json().student).to.eql('Polevchshikov Zakariya'));"
            ]
          }
        }
      ]
    },
    {
